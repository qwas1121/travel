# 이 파일을 복사해서 .env.local 로 저장한 뒤 값을 채워주세요.
# cp .env.local.example .env.local

# --- Google Drive (서비스 계정) ---
# Google Cloud Console에서 서비스 계정을 만들고 발급받은 JSON 키에서 값을 가져옵니다.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# JSON 키의 private_key 값을 그대로 붙여넣으세요. 줄바꿈은 \n으로 이스케이프된 형태 그대로 두면 됩니다.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 사진을 올려둔 Google Drive 폴더 ID (폴더 URL의 마지막 부분)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Supabase (앨범/캡션 메타데이터, 선택 사항) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 사이트 비밀번호 보호 ---
SITE_PASSWORD=
# 아래 명령으로 랜덤 문자열을 만들어 사용하세요: openssl rand -base64 32
SESSION_SECRET=
